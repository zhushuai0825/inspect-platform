[Unit]
Description=Inspect Platform (QA dashboard)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/inspect-platform
Environment=QA_BIND=127.0.0.1
Environment=QA_PORT=8765
ExecStart=/usr/bin/python3 /opt/inspect-platform/app.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
