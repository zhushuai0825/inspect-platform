[Unit]
Description=QA Inspector durable email outbox (disabled until SMTP configured)
After=network.target inspect-platform.service
[Service]
Type=simple
WorkingDirectory=/opt/inspect-platform
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/inspect-platform/notifications.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/inspect-platform/data
[Install]
WantedBy=multi-user.target
