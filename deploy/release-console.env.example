# Copy the keys you need into data/secret.env on the server. Do not commit that file.
# Leave job names empty until an operator creates the trusted Jenkins jobs by hand.
# This repository does not create those jobs and does not contact Jenkins by itself.

# Existing Jenkins API credentials. Never commit real values.
JENKINS_URL=http://127.0.0.1:8088/jenkins
JENKINS_USER=
JENKINS_API_TOKEN=

# Trusted job names copied later from jenkins/templates/. Empty means unwired.
RELEASE_JENKINS_FRONTEND_DEPLOY_JOB=
RELEASE_JENKINS_BACKEND_DEPLOY_JOB=

# Label stored on each record. The console does not open a connection to this host.
RELEASE_PUBLISH_HOST=8.146.206.64

# 1: after a publish reaches succeeded, failed, or rolled_back, run the existing inspect suite.
# 0: record inspect_status=disabled and do not start a run.
# Either value keeps the builtin personal-site checks unchanged.
RELEASE_INSPECT_AFTER_PUBLISH=1

# Optional override. Default is $QA_DATA_DIR/release_console.db or data/release_console.db.
# RELEASE_DB_PATH=
# Optional override for tests. Default is data/secret.env beside the app.
# RELEASE_SECRET_FILE=
