[Unit]
Description=Inspect Deploy Dispatcher
Documentation=https://github.com/zhushuai0825/inspect-platform
After=network.target

[Service]
Type=simple
User=inspect-dispatcher
Group=inspect-deploy
WorkingDirectory=/var/lib/inspect-deploy

# 控制面配置（group readable）
# /opt/inspect-deploy/config: config.json group=inspect-deploy mode=640

# 应用访问（读写）
# /opt/inspect-platform: 应用根目录
# /opt/inspect-ops/state: release版本状态（实际路径）
# /var/lib/inspect-deploy: dispatcher工作目录（work/log）
ProtectSystem=strict
ReadWritePaths=/opt/inspect-platform
ReadWritePaths=/opt/inspect-ops/state
ReadWritePaths=/var/lib/inspect-deploy

# 临时目录（Git clone等）
PrivateTmp=yes

# 安全加固
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# 能力限制
# dispatcher需要调用sudo执行release.py
# 通过 /etc/sudoers.d/inspect-deploy 配置sudo权限
CapabilityBoundingSet=

# 环境
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# 启动命令
ExecStart=/usr/bin/python3 /opt/inspect-deploy/bin/dispatcher.py

# 重启策略
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
